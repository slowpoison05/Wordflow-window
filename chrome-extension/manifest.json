{
  "manifest_version": 3,
  "name": "WordFlow Browser",
  "version": "1.0.0",
  "description": "Write saved text into supported webpage fields using WordFlow.",
  "permissions": ["contextMenus", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "action": { "default_title": "WordFlow settings", "default_popup": "popup.html" }
}